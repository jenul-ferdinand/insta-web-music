{
  "manifest_version": 3,
  "name": "InstaWebMusic",
  "version": "0.1.1",
  "description": "Hear the music on Instagram photo posts in your browser, not just the app.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["music.js"],
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "web-music@jenul",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
